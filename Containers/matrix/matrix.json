{
    "aio_services_v1": [
        {
            "container_name": "nextcloud-aio-matrix",
            "display_name": "Matrix Synapse Server",
            "documentation": "https://github.com/nextcloud/all-in-one/tree/main/community-containers/matrix-synapse",
            "image": "matrixdotorg/synapse",
            "image_tag": "latest",
            "internal_port": "8008",
            "restart": "unless-stopped",
            "environment": [
                "SYNAPSE_SERVER_NAME=matrix.%NC_DOMAIN%",
                "SYNAPSE_REPORT_STATS=no",
                "SYNAPSE_HTTP_PORT=8008",
                "SYNAPSE_CONFIG_DIR=/data",
                "SYNAPSE_DATA_DIR=/data",
                "POSTGRES_HOST=nextcloud-aio-database",
                "POSTGRES_USER=matrix_user",
                "POSTGRES_PASSWORD=%MATRIX_DB_PASSWORD%",
                "POSTGRES_DATABASE=matrix_db",
                "TZ=%TIMEZONE%"
            ],
            "secrets": [
                "MATRIX_REGISTRATION_SECRET",
                "MATRIX_DB_PASSWORD"
            ],
            "ports": [
                {
                    "ip_binding": "%APACHE_IP_BINDING%",
                    "port_number": "8008",
                    "protocol": "tcp"
                }
            ],
            "volumes": [
                {
                    "source": "nextcloud_aio_matrix_data",
                    "destination": "/data",
                    "writeable": true
                }
            ],
            "backup_volumes": [
                "nextcloud_aio_matrix_data"
            ],
            "depends_on": [
                "nextcloud-aio-database"
            ]
        }
    ]
}
